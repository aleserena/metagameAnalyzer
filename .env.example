# Copy this file to .env (or .env.dev / .env.staging / .env.prod) and fill in values.
# Set DB_ENV=dev|staging|prod to load .env.dev, .env.staging, or .env.prod instead of .env.

# Logging (for Railway/monitoring: use LOG_FORMAT=json and LOG_LEVEL=INFO or DEBUG)
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Database (required). The app requires PostgreSQL; there is no JSON-only mode.
# DATABASE_URL=postgresql://user:password@localhost:5432/mtgtop8

# Optional: which env file to load (dev, staging, prod)
# DB_ENV=dev

# Directory for data files (decks.json, player_aliases.json, etc.). Relative to project root or absolute.
# DATA_DIR=.

# Max size in bytes for JSON file uploads (admin load deck import, POST /api/v1/load file, event deck upload). Default 52428800 (50 MiB).
# MAX_UPLOAD_JSON_BYTES=52428800

# CORS allowed origins (comma-separated). Default allows Vite dev server.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin login and JWT. Set in production.
# ADMIN_PASSWORD=your-secret-password
# JWT_SECRET=your-jwt-secret

# Public app URL (e.g. for links in emails or redirects)
# PUBLIC_APP_URL=https://your-domain.com

# Email (Brevo): for sending missing-deck links and event feedback links. Admin-only; no emails in API responses.
# Option A – Brevo SMTP: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD. SMTP_FROM optional (defaults to SMTP_USER).
# Option B – Brevo API: BREVO_API_KEY (from Brevo → SMTP & API) and SMTP_FROM (required; verified sender in Brevo).
# If not fully set, "Send email" actions return 503 with a hint.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@example.com
# SMTP_PASSWORD=your-smtp-key
# SMTP_FROM=noreply@yourdomain.com
# BREVO_API_KEY=

# Feedback form: create GitHub issues from the app (no user GitHub account required).
# GITHUB_TOKEN=ghp_... (Personal Access Token with repo scope, or fine-grained with Issues: Write)
# GITHUB_REPO=owner/repo (e.g. aleserena/metagameAnalyzer). Repo must have labels: bug, enhancement, question.

# Operator alerts (api/services/alerts.py): when DATABASE_URL is set but the DB is unusable at
# startup, the API logs event=db_unavailable, /api/v1/health returns 503, admins see a banner, and
# an alert goes out as a GitHub issue labelled "alert" (uses GITHUB_TOKEN/GITHUB_REPO above) and
# an email to ALERT_EMAIL (comma-separated; uses the Brevo settings above).
# Alerts are sent on Railway by default; ALERTS_ENABLED=1 forces them on elsewhere, 0 turns them off.
# ALERT_EMAIL is also emailed for every ERROR/CRITICAL log record (unhandled 500s, failed scrapes/syncs,
# uncaught thread exceptions), batched into one email per ALERT_EMAIL_BATCH_SECONDS, the same error at
# most once per ALERT_EMAIL_COOLDOWN_SECONDS (repeats are counted), capped at ALERT_EMAIL_MAX_PER_HOUR.
# It also gets a "Deployed" email for each new Railway deployment and "Restarted" when the same
# deployment starts again (usually a crash); the last deployment id is kept in DATA_DIR.
# Log lines carry request_id (also returned as the X-Request-ID header), env and build.
# ALERT_EMAIL=you@example.com
# ALERTS_ENABLED=
# ALERT_EMAIL_BATCH_SECONDS=30
# ALERT_EMAIL_COOLDOWN_SECONDS=900
# ALERT_EMAIL_MAX_PER_HOUR=20
# SLOW_REQUEST_MS=5000   (requests slower than this log at WARNING)

# Scraper: max parallel workers (1–8). Default 1.
# SCRAPER_MAX_WORKERS=1

# SQL echo (log queries). Set to 1 or true to enable.
# SQL_ECHO=
